# Copy to .env and fill in. NEVER commit .env (it's gitignored).

# --- Required ---
# DeepSeek API key (https://platform.deepseek.com) — powers the bot.
DEEPSEEK_API_KEY=sk-your-deepseek-key

# The ONLY WhatsApp number allowed to use the bot, E.164 format.
# (Keep it locked to your own number while testing; open up for production.)
ALLOWED_NUMBER=+923000000000

# Admin dashboard password (the username is always "admin"). Use a strong value.
ADMIN_PASS=change-this-to-a-strong-password

# --- Kapso (official WhatsApp Cloud API) — for the Kapso migration ---
# Active transport: "baileys" (default) or "kapso". scripts/kapso-cutover.sh
# flips this; workspace scripts (send_product, notify_admins, db.py) obey it.
WA_TRANSPORT=baileys

# Kapso API key (from the Kapso dashboard). Used for sending, contacts, and
# mirroring customer categories into Kapso contact metadata.
KAPSO_API_KEY=

# The Kapso phone number id the bot sends from
# (list them: python3 workspace/kapso.py numbers)
KAPSO_PHONE_NUMBER_ID=

# Shared webhook secret. In poller mode (no public URL) it only needs to match
# between scripts/kapso_poller.py and the gateway config — no dashboard step.
KAPSO_WEBHOOK_SECRET=

# OPTIONAL: permanent public HTTPS URL to the gateway (VPS domain or named
# Cloudflare tunnel). If set, kapso-cutover.sh registers a real Kapso webhook
# and skips the polling relay. Leave empty to use polling (works behind NAT).
KAPSO_PUBLIC_URL=

# Polling relay tuning (poller mode only)
KAPSO_POLL_SECONDS=5

# OPTIONAL: the bot's own WhatsApp display number. The poller uses it to drop
# outbound echoes that arrive without a direction field.
KAPSO_DISPLAY_NUMBER=

# --- Optional ---
# Required if voice-message transcription is enabled.
OPENROUTER_API_KEY=
OPENROUTER_HTTP_REFERER=
OPENROUTER_APP_TITLE=

# openclaw gateway auth token. Leave blank to auto-generate on first run.
GATEWAY_TOKEN=

# Delete processed voice-message audio/transcripts after this many days.
# Set to 0 to delete on the next maintenance pass. Default: 7.
VOICE_RETENTION_DAYS=7

# Maintenance/cleanup frequency. Default: every 6 hours.
MAINTENANCE_INTERVAL_SECONDS=21600
